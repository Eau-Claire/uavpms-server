AMQP_URL=amqp://REPLACE_USER:REPLACE_PASSWORD@rabbitmq:5672/
MODAL_URL=https://REPLACE.modal.run
MODAL_KEY=REPLACE
MODAL_SECRET=REPLACE
MEDIA_ALLOWED_HOSTS=REPLACE_STORAGE_HOST
CATEGORY_MAP=/config/categories.json
STATE_DIR=/state
# Jobs processed at once (1..8).
WORKERS=3
# Video: the best frame of each defect is saved to MinIO and sent as ImageUrl (same names as the BE .env).
# Leave empty to skip saving frames (detections are still grouped, one per defect).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE
MINIO_SECRET_KEY=REPLACE
MINIO_BUCKET=uav-media
MINIO_USE_SSL=false
MINIO_PUBLIC_BASE_URL=https://REPLACE_STORAGE_HOST
